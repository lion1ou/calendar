{
  "name": "calendar-utools-vue3",
  "version": "1.0.0",
  "scripts": {
    "ensure-env": "node scripts/ensure-env.js",
    "predev": "npm run ensure-env",
    "prebuild": "npm run ensure-env",
    "dev": "concurrently -n client,server -c blue,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsup server/index.ts --format cjs --out-dir server-dist --external dotenv --no-splitting",
    "start": "node server-dist/index.js",
    "serve": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "lint": "eslint src --ext .ts,.tsx,.vue --fix",
    "lint:fix": "eslint src --ext .ts,.tsx,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,vue,json,css,less,scss}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,vue,json,css,less,scss}\"",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,vue,json,css,less,scss}\" && eslint --fix \"src/**/*.{js,jsx,ts,tsx,vue}\""
  },
  "dependencies": {
    "axios": "^0.27.2",
    "cors": "^2.8.6",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "vue": "^3.0.5",
    "vue-router": "^4.0.12",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-vue": "^1.1.5",
    "@vue/compiler-sfc": "^3.0.5",
    "autoprefixer": "^10.4.2",
    "concurrently": "^9.2.1",
    "less": "^4.1.2",
    "naive-ui": "^2.26.0",
    "postcss": "^8.4.6",
    "tailwindcss": "^3.0.22",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^4.1.3",
    "vite": "^2.0.5"
  },
  "description": "基于Vue 3 + Typescript + Vite实现的日历插件",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lion1ou/calendar.git"
  },
  "keywords": [
    "calendar",
    "日历"
  ],
  "author": "lion1ou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lion1ou/calendar/issues"
  },
  "homepage": "https://github.com/lion1ou/calendar#readme"
}
