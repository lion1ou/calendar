# 复制为 .env 或 .env.local 后填入真实值，勿提交到仓库
# Copy to .env or .env.local and fill in real values. Do not commit.

# 高德天气 API Key (https://lbs.amap.com/)
VITE_GD_WEATHER_KEY=

# 和风天气 API Key (https://dev.qweather.com/)
VITE_HF_WEATHER_KEY=

# 心知天气 Public Key / UID (https://www.seniverse.com/)
VITE_XZ_WEATHER_KEY=

# 心知天气 Secret Key（用于签名，请勿泄露）
VITE_XZ_WEATHER_SECRET=

# 本地存储前缀（可选，默认 toy-calendar）
# VITE_STORAGE_KEY=toy-calendar
