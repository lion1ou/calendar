# ============================================================
# 环境配置模板
# 复制为 .env 并填入真实值，勿提交到仓库
# Copy to .env and fill in real values. Do not commit.
# ============================================================

# ---- 天气 API 密钥（服务端使用，不暴露到前端） ----

# 高德天气 API Key (https://lbs.amap.com/)
GD_WEATHER_KEY=

# 和风天气 API Key (https://dev.qweather.com/)
HF_WEATHER_KEY=

# 心知天气 Public Key / UID (https://www.seniverse.com/)
XZ_WEATHER_KEY=

# 心知天气 Secret Key（用于签名）
XZ_WEATHER_SECRET=

# ---- Node 服务配置 ----

# 服务端口（默认 5555）
SERVER_PORT=5555

# 运行环境 (development | production)
NODE_ENV=development

# ---- 前端配置 ----

# 本地存储前缀（可选，默认 calendar）
# VITE_STORAGE_KEY=calendar

# ---- 部署配置（仅本地部署脚本使用） ----

# 远程服务器 SSH 地址（如 root@1.2.3.4）
DEPLOY_HOST=

# 远程部署目录
DEPLOY_DIR=/xxx/xxxx/calendar

# 远程临时上传目录
DEPLOY_UPLOAD_DIR=/xxx/xxxx

# 应用名称（用于 PM2 进程名和目录名）
DEPLOY_APP_NAME=calendar
